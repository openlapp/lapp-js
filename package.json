{
  "name": "lapp-js",
  "version": "0.1.2",
  "private": true,
  "description": "TypeScript SDK and CLI workspace for LAPP (Local AI Provider Profiles).",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:vault:system": "vitest run packages/lapp/test/system-vault.test.ts --pool=forks --minWorkers=1 --maxWorkers=1",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "pnpm --filter @openlapp/lapp run build && pnpm -r run lint",
    "smoke:pack": "tsx scripts/pack-smoke.mts",
    "registry:up": "docker compose -f dev/registry/compose.yaml up -d --wait",
    "registry:init": "tsx scripts/init-local-registry.mts",
    "registry:down": "docker compose -f dev/registry/compose.yaml down",
    "registry:reset": "tsx scripts/reset-local-registry.mts",
    "registry:logs": "docker compose -f dev/registry/compose.yaml logs -f registry",
    "registry:publish": "tsx scripts/publish-local.mts",
    "registry:smoke": "tsx scripts/smoke-local-registry.mts",
    "verify:spec": "node scripts/verify-schema.mjs",
    "clean": "pnpm -r run clean",
    "verify:docs": "tsx scripts/verify-cli-docs.mts && tsx scripts/verify-protocols.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
