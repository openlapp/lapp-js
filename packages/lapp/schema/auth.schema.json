{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lapp.dev/schema/1.1/auth.schema.json",
  "title": "LAPP 1.1 auth.json",
  "type": "object",
  "required": ["schemaVersion", "id", "driver", "protocols"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "id": { "$ref": "#/$defs/portableId" },
    "name": { "type": "string", "minLength": 1 },
    "driver": { "$ref": "#/$defs/driverId" },
    "enabled": { "type": "boolean" },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/protocolId" }
    },
    "config": { "$ref": "#/$defs/nonSecretConfig" },
    "extensions": { "$ref": "#/$defs/nonSecretConfig" }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "allOf": [
        { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        { "not": { "anyOf": [
          { "pattern": "^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)" },
          { "pattern": "\\.$" }
        ] } }
      ]
    },
    "driverId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "protocolId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "nonSecretConfig": {
      "type": "object",
      "$comment": "Keys are checked after ASCII case-folding and separator removal; only tokenEndpoint and deviceCodeUrl are sensitive-family exceptions.",
      "propertyNames": {
        "not": {
          "anyOf": [
            { "pattern": "^(?![tT][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[pP][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[tT]$)[\\s\\S]*[tT][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[nN]" },
            { "pattern": "[sS][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[tT]" },
            { "pattern": "[pP][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[wW][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[dD]" },
            { "pattern": "[pP][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[pP][^A-Za-z0-9]*[hH][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[eE]" },
            { "pattern": "[aA][^A-Za-z0-9]*[pP][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[yY]" },
            { "pattern": "[pP][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[vV][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[tT][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[yY]" },
            { "pattern": "[aA][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[yY]" },
            { "pattern": "[sS][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[yY]" },
            { "pattern": "[sS][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[gG][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[gG][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[yY]" },
            { "pattern": "[cC][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[nN][^A-Za-z0-9]*[tT][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[lL]" },
            { "pattern": "[cC][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[kK][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[eE]" },
            { "pattern": "[aA][^A-Za-z0-9]*[uU][^A-Za-z0-9]*[tT][^A-Za-z0-9]*[hH][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[zZ][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[tT][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[nN]" },
            { "pattern": "^(?![dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[vV][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[uU][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[lL]$)[\\s\\S]*[dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[vV][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[eE]" },
            { "pattern": "[cC][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[vV][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[fF][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[rR]" },
            { "pattern": "[dD][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[vV][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[aA][^A-Za-z0-9]*[uU][^A-Za-z0-9]*[tT][^A-Za-z0-9]*[hH][^A-Za-z0-9]*[iI][^A-Za-z0-9]*[dD]" },
            { "pattern": "[uU][^A-Za-z0-9]*[sS][^A-Za-z0-9]*[eE][^A-Za-z0-9]*[rR][^A-Za-z0-9]*[cC][^A-Za-z0-9]*[oO][^A-Za-z0-9]*[dD][^A-Za-z0-9]*[eE]" }
          ]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/nonSecretValue" }
    },
    "nonSecretValue": {
      "anyOf": [
        { "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/nonSecretValue" } },
        { "$ref": "#/$defs/nonSecretConfig" }
      ]
    }
  }
}
